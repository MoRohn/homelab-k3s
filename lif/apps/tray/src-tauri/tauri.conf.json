{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labzilla",
  "version": "0.1.0",
  "identifier": "local.labzilla.tray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "quick",
        "title": "Ask Labzilla",
        "url": "quick.html",
        "width": 440,
        "height": 188,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Labzilla in your tray: quick Ask and the full console",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    }
  }
}
