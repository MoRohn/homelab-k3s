{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:GetBucketLocation"], "Resource": ["arn:aws:s3:::longhorn-backups"]},
    {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": ["arn:aws:s3:::longhorn-backups"],
     "Condition": {"StringLike": {"s3:prefix": ["lif-sqlite/*", "lif-sqlite/"]}}},
    {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
     "Resource": ["arn:aws:s3:::longhorn-backups/lif-sqlite/*"]}
  ]
}
