# Publishes labzilla.local on the LAN via mDNS (avahi) so phones can open the Labzilla Console
# without DNS or /etc/hosts. No sudo: avahi-publish talks to avahi-daemon over D-Bus as this user.
# Install (user unit; linger keeps it running without a login session):
#   cp homelab/host/systemd/labzilla-mdns.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now labzilla-mdns
# The address is read at start from LABZILLA_MDNS_IFACE (DHCP can change it; the unit restarts on failure).
[Unit]
Description=Publish labzilla.local via mDNS (Labzilla Console)
After=network-online.target

[Service]
Environment=LABZILLA_MDNS_IFACE=wlP9s9
ExecStart=/bin/sh -c 'ip=$(ip -4 -o addr show dev "$LABZILLA_MDNS_IFACE" | awk "{print \\$4}" | cut -d/ -f1 | head -1); [ -n "$ip" ] || exit 1; exec /usr/bin/avahi-publish -a -R labzilla.local "$ip"'
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
