# labzilla is a PUBLIC repo. Anything sensitive lives in one of three git-ignored roots
# (each keeps only its README). See README.md → "What stays private".
# The pre-commit guard (.githooks/pre-commit) enforces the same rules on staged files.

# ---- Credentials: never leave this machine ----
/secrets/*
!/secrets/README.md
*.env
.env*
!*.env.example
*.pem
*.key
*.crt
*.p12
*.kubeconfig
kubeconfig*
k3s.yaml

# ---- Your notes, drafts, scratch, AI memory/thinking exports ----
/personal/*
!/personal/README.md

# ---- Sensitive project docs and production data (audit, security, BLERBZ, live observations) ----
/private/*
!/private/README.md
# Compatibility links into private/ (e.g. for a long-running observer that writes there)
/lif/benchmarks/blerbz-takeover

# ---- AI assistant local state (CLAUDE.md is public and tracked; these are not) ----
CLAUDE.local.md
.claude/*
!.claude/settings.json
.claude/settings.local.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Backups, scratch, editor/OS clutter ----
*.bak
*.orig
*.swp
*~
.DS_Store
.vscode/
.idea/
tmp/
